# LED Panels Display Configuration Example
# Copy this file to settings.toml and customize for your setup
#
# Global sections come first — they describe the box itself and apply to
# whichever mode is running. Anything a single mode owns lives under
# [mode.<name>] at the bottom.

# --- Global ----------------------------------------------------------------

[hardware]
# Physical panel configuration — the only copy. Every mode renders to it.
width = 64           # Single panel width in pixels
height = 32          # Single panel height in pixels
chain = 2            # Panels chained horizontally
parallel = 4         # Panels stacked vertically
gpio_slowdown = 3    # GPIO slowdown for RGBMatrixOptions (0-4, higher = slower but more stable)

[network]
# Output backend configuration
# Only one backend should be enabled at a time: direct matrix control, FPP, or ColorLight

# FPP (Falcon Player Protocol) network output
# Use this to send display data to a remote FPP instance over the network
fpp_enabled = false
fpp_host = "127.0.0.1"       # IP address of FPP receiver
fpp_port = 4048              # DDP port (default: 4048)

# ColorLight 5A-75B direct Ethernet output
# Sends frames directly to ColorLight controller via raw Ethernet (requires root/sudo on Linux)
colorlight_enabled = true
colorlight_interface = "eth0"  # Network interface name (e.g., eth0, enp0s3, wlan0)
# Pause after each row is written, in milliseconds. Dominates ColorLight frame
# time — a 128-row panel spends ~128ms per frame here, capping it near 7fps.
# Lower it to speed up animation, but too low tears frames; tune on hardware.
colorlight_row_delay_ms = 1.0

[fonts]
# Absolute path to the directory holding the BDF fonts. Every mode names a
# bare filename inside it, so this is the only place a path appears.
# Bundled fonts: helvB14.bdf, helvB18.bdf, helvB24.bdf, Roboto-Black-50.bdf
# Examples:
#   Windows: font_path = "C:/Users/mike/Documents/Code Projects/LED Panels/fonts"
#   Linux:   font_path = "/home/mike/LedPanels/fonts"
font_path = "C:/Users/mike/Documents/Code Projects/LED Panels/fonts"

[files]
# Team color mappings (affiliation,name,bgcolor,text), relative to this config
# directory. Read by display_event, athletic_live_scoreboard and the web UI.
colors_file = "colors.csv"

[web]
# Web interface for remote control and configuration
# Access from any browser on the network: http://<raspberry-pi-ip>
# Provides pages for viewing/changing current event, editing team colors, and adjusting display settings
web_enabled = true           # Enable web interface
web_host = "0.0.0.0"          # Host to bind to (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
# Port 80 needs root on Linux and macOS. Running a mode script directly as an
# unprivileged user will fail to bind it — set 5000 (or any port above 1024) here.
web_port = 80                # Port for web server

[manager]
# display_manager.py — the process the systemd service starts. It hosts the
# web UI and runs one display mode as a child process, restarting it on crash.
active_mode = "display_event"   # display_event | athletic_live_scoreboard | udp_scoreboard | animation_display
auto_restart = true             # Restart the display mode if it exits
restart_backoff_sec = 5         # Seconds to wait before restarting

# --- Per-mode --------------------------------------------------------------
# Only the active mode reads its own section. Panel geometry, output backend,
# font directory and colors_file all come from the global sections above.

[mode.display_event]
# Paged event listings from a Lynx .evt file.
line_height = 24              # Athlete row height in pixels
header_line_height = 16       # Header row height in pixels
header_rows = 2               # Number of header rows (allows text wrapping for long event names)
interval = 2.0                # Seconds per page when paging through athletes
font_shift = 0                # Font positioning adjustment (vertical offset in pixels)
font_name = "helvB14.bdf"     # Bare filename inside [fonts].font_path
lynx_file = "lynx.evt"        # Event timing data (CSV from the Lynx timing system)
once = false                  # If true, render once and exit; if false, loop continuously
keyboard_device = ""          # evdev input device (e.g. "/dev/input/event2"); empty = auto-detect
# Watches lynx.evt, current_event.json, colors.csv, lynx.sch and settings.toml
# and reloads the display when any of them changes.
file_watch_enabled = true

[mode.athletic_live_scoreboard]
# Live field-event scoreboard polled from sb.athletic.live.
# name and uuid are required before this mode can start, and come from the
# scoreboard URL: https://sb.athletic.live/...?name=FUSHIABOX&uuid=dc4113ed-...
# They can also be set from the web UI.
name = ""                       # Scoreboard computer name
uuid = ""                       # Scoreboard UUID
poll_interval = 3.0             # Seconds between polls
font_name = "helvB14.bdf"       # Bare filename inside [fonts].font_path

[mode.udp_scoreboard]
# Two-section scoreboard driven by JSON messages over UDP: event name on top,
# running time below.
udp_port = 5568                 # UDP port to listen on for JSON messages
buffer_size = 4096              # Maximum UDP packet size
top_height = 24                 # Height of the event-name band in pixels
bottom_height = 0               # Height of the time band; 0 = rest of the panel
top_font_name = "helvB18.bdf"            # Bare filename inside [fonts].font_path
bottom_font_name = "Roboto-Black-50.bdf" # Bare filename inside [fonts].font_path

# Font positioning adjustments (offsets in pixels)
top_font_shift_vertical = 0       # Vertical offset for the event name
top_font_shift_horizontal = 0     # Horizontal offset for the event name (adjust if not centered)
bottom_font_shift_vertical = 0    # Vertical offset for the time
bottom_font_shift_horizontal = 0  # Horizontal offset for the time (adjust if not centered)

[mode.animation_display]
# Plays a looping GIF or video clip. A bare filename resolves inside
# config/animations/, which is where web UI uploads land; an absolute path is
# also accepted. GIF/APNG/WebP need nothing extra, MP4/MOV/WebM need ffmpeg
# on PATH ("sudo apt install ffmpeg").
file = ""                       # Required before this mode can start
fit = "contain"                 # contain (letterbox) | cover (crop) | stretch
fps = 0                         # 0 keeps the source's own timing
loop = true                     # Repeat forever vs. play once and exit
background = "#000000"          # Fill behind letterboxing and transparency
max_frames = 600                # Cap on decoded frames
ffmpeg = ""                     # Path to the ffmpeg binary; empty searches PATH
